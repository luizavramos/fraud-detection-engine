{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motorfraude:schema:fraud-decision:v1",
  "title": "FraudDecision v1",
  "description": "Toda decisao do motor (alerta ou nao), motor -> S3 (topico fraud-decisions.v1). features e um mapa aberto com limites: chaves em padrao fixo e valores escalares curtos, para nao carregar dado pessoal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "transactionId", "accountId", "decision", "score", "severity", "triggeredRules", "shadowHits", "features", "ruleSetVersion", "contextCompleteness", "eventReceivedAt", "decidedAt"],
  "properties": {
    "decisionId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "transactionId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,64}$" },
    "accountId": { "type": "string", "pattern": "^acc_tok_[A-Za-z0-9]{4,64}$" },
    "decision": { "enum": ["ALERT", "NO_ALERT"] },
    "score": { "type": "integer", "minimum": 0 },
    "severity": { "enum": ["NONE", "MEDIUM", "HIGH"] },
    "triggeredRules": { "type": "array", "items": { "$ref": "#/$defs/ruleHit" } },
    "shadowHits": { "type": "array", "items": { "$ref": "#/$defs/ruleHit" } },
    "features": { "$ref": "#/$defs/scalarMap" },
    "ruleSetVersion": { "type": "integer", "minimum": 1 },
    "contextCompleteness": { "enum": ["FULL", "PARTIAL"] },
    "eventReceivedAt": { "$ref": "#/$defs/instantUtc" },
    "decidedAt": { "$ref": "#/$defs/instantUtc" }
  },
  "$defs": {
    "ruleHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "version", "weight", "reason"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,31}$" },
        "version": { "type": "integer", "minimum": 1 },
        "weight": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "scalarMap": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_.]{0,63}$" },
      "additionalProperties": {
        "anyOf": [
          { "type": "number" },
          { "type": "boolean" },
          { "type": "string", "maxLength": 64 }
        ]
      }
    },
    "instantUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
