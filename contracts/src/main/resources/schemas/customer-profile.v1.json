{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motorfraude:schema:customer-profile:v1",
  "title": "CustomerProfile v1",
  "description": "Perfil pre-calculado sem dado pessoal, customer-service -> motor (topico customer-profile.v1, compactado). Estrito: qualquer coluna extra do CDC (nome, cpf, e-mail, telefone) invalida a mensagem.",
  "type": "object",
  "additionalProperties": false,
  "required": ["accountId", "segment", "accountOpenedAt", "knownDeviceHashes", "updatedAt"],
  "properties": {
    "accountId": { "type": "string", "pattern": "^acc_tok_[A-Za-z0-9]{4,64}$" },
    "segment": { "enum": ["PF", "PJ"] },
    "accountOpenedAt": { "$ref": "#/$defs/instantUtc" },
    "lastCredentialChangeAt": { "oneOf": [{ "$ref": "#/$defs/instantUtc" }, { "type": "null" }] },
    "knownDeviceHashes": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^dev_[A-Za-z0-9]{8,64}$" }
    },
    "updatedAt": { "$ref": "#/$defs/instantUtc" }
  },
  "$defs": {
    "instantUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
