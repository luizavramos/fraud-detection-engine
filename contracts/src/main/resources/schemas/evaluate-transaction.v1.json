{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motorfraude:schema:evaluate-transaction:v1",
  "title": "EvaluateTransaction v1",
  "description": "Comando receiver -> motor (topico transaction-commands.v1) e corpo de POST /v1/transactions:evaluate. Somente tokens: nunca CPF, nome, numero de conta, e-mail ou telefone. Dinheiro em centavos (inteiro). Instantes em UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "accountId", "customerId", "type", "amount", "counterparty", "channel", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transactionId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,64}$", "description": "Chave de idempotencia." },
    "accountId": { "$ref": "#/$defs/accountToken" },
    "customerId": { "type": "string", "pattern": "^cus_tok_[A-Za-z0-9]{4,64}$" },
    "type": { "enum": ["PIX", "TED", "BOLETO", "CARD"] },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "currency"],
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Centavos." },
        "currency": { "enum": ["BRL"] }
      }
    },
    "counterparty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountToken", "bankIspb"],
      "properties": {
        "accountToken": { "$ref": "#/$defs/accountToken" },
        "bankIspb": { "type": "string", "pattern": "^[0-9]{8}$" }
      }
    },
    "channel": { "enum": ["MOBILE", "WEB", "API", "BRANCH"] },
    "deviceIdHash": { "$ref": "#/$defs/deviceToken" },
    "occurredAt": { "$ref": "#/$defs/instantUtc" }
  },
  "$defs": {
    "accountToken": { "type": "string", "pattern": "^acc_tok_[A-Za-z0-9]{4,64}$" },
    "deviceToken": { "type": "string", "pattern": "^dev_[A-Za-z0-9]{8,64}$" },
    "instantUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
