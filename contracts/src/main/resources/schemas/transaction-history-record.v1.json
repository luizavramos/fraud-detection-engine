{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motorfraude:schema:transaction-history-record:v1",
  "title": "TransactionHistoryRecord v1",
  "description": "Registro de historico (carga inicial de 90 dias), transaction-service -> motor (topico transaction-history-backfill.v1). Sem nome nem CPF do pagador.",
  "type": "object",
  "additionalProperties": false,
  "required": ["transactionId", "accountId", "amount", "counterpartyToken", "occurredAt"],
  "properties": {
    "transactionId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,64}$" },
    "accountId": { "type": "string", "pattern": "^acc_tok_[A-Za-z0-9]{4,64}$" },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "currency"],
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Centavos." },
        "currency": { "enum": ["BRL"] }
      }
    },
    "counterpartyToken": { "type": "string", "pattern": "^acc_tok_[A-Za-z0-9]{4,64}$" },
    "deviceIdHash": { "type": "string", "pattern": "^dev_[A-Za-z0-9]{8,64}$" },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
