{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motorfraude:schema:rule-set:v1",
  "title": "RuleSet v1",
  "description": "Conjunto ativo de regras, gestao de regras -> motor (HTTP GET /v1/rule-sets/active, ETag/304). So regras ACTIVE e SHADOW entram no conjunto; DRAFT e desligadas ficam na gestao. params e paramOverrides sao mapas abertos com limites.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "publishedAt", "scoring", "rules"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediumThreshold", "highThreshold"],
      "properties": {
        "mediumThreshold": { "type": "integer", "minimum": 1 },
        "highThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "version", "status", "expression", "params", "paramOverrides", "weight", "reasonTemplate"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,31}$" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["ACTIVE", "SHADOW"] },
        "expression": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "params": { "$ref": "#/$defs/params" },
        "paramOverrides": {
          "type": "object",
          "propertyNames": { "enum": ["PF", "PJ"] },
          "additionalProperties": { "$ref": "#/$defs/params" }
        },
        "weight": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "reasonTemplate": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "scalar": {
      "anyOf": [
        { "type": "number" },
        { "type": "boolean" },
        { "type": "string", "maxLength": 64 }
      ]
    },
    "params": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_.]{0,63}$" },
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/scalar" },
          { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/scalar" } }
        ]
      }
    }
  }
}
