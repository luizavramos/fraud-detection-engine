# Copie para .env para mudar portas do host se alguma estiver ocupada.
# Os valores abaixo são os padrões usados pelo docker-compose.yml.

# Infraestrutura
KAFKA_HOST_PORT=9092
CONNECT_HOST_PORT=18083
POSTGRES_HOST_PORT=5432
BANK_DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# Credenciais locais (somente desenvolvimento; em produção vêm do Secrets Manager)
POSTGRES_USER=motorfraude
POSTGRES_PASSWORD=motorfraude
BANK_DB_USER=bank
BANK_DB_PASSWORD=bank
GRAFANA_ADMIN_PASSWORD=admin

# Serviços da aplicação (entram no compose pelas specs 001–006)
RECEIVER_PORT=8081
RULE_MANAGEMENT_PORT=8082
CUSTOMER_SERVICE_PORT=8083
DETECTION_ENGINE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
TRANSACTION_SERVICE_PORT=8086
RECEIVER_HOST_PORT=8081
RECEIVER_MEM_LIMIT=512m

# Pasta do repositório receiver (padrão: ../receiver, clonado ao lado deste)
# RECEIVER_CONTEXT=../receiver
